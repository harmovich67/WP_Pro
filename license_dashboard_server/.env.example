# Copy to .env locally, or set these as environment variables on your host.
# Never commit the real values.

# Admin dashboard login token (used in Authorization: Bearer <ADMIN_TOKEN>)
ADMIN_TOKEN=change-me-to-a-long-random-value

# Used to sign/verify data. Keep secret.
SECRET_KEY=change-me-to-a-long-random-value

# Optional: switch to Postgres/MySQL in production instead of the default SQLite file.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
